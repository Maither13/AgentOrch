# 复制为 .env 后填写
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

ENVIRONMENT=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000

# 离线演示 / 单元测试：不发起真实请求
LLM_MOCK=false
# Mock 模式下评审固定驳回，用于演示 Self-Loop 轮次
MOCK_REVIEW_REJECT=false
